# =============================================================================
# CottonOGD 后端环境变量模板
# 用法：cp .env.example .env，再填入真实值
# .env 文件禁止提交到 git（已在 .gitignore 中忽略）
# =============================================================================

# ---- Django ----
DEBUG=False
# 生成新 key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=please-replace-with-your-secret-key

# ---- MySQL ----
MYSQL_DB_NAME=cottonogd-ortho
MYSQL_DB_USER=cottonogd
MYSQL_DB_PASSWORD=
MYSQL_DB_HOST=localhost
# 远程库（"server" 连接配置用）
MYSQL_DB_HOST_REMOTE=172.28.226.114
MYSQL_DB_PORT=3306

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# ---- Meilisearch ----
MEILISEARCH_URL=http://127.0.0.1:7700
# master key 只在后端使用，禁止暴露给前端
MEILISEARCH_MASTER_KEY=
# search-only key，可分发到前端
MEILISEARCH_FRONTEND_API_KEY=
# 同步游标文件路径（可选，不设走默认）
# MEILISEARCH_CURSOR_PATH=/data/web/CottonOGD/OGD/backend/data/meilisync_cursor.json

# ---- AI Chat（OpenAI 兼容大模型接口）----
# API key 只在后端使用，禁止暴露给前端；AI_CHAT_BASE_URL 必须是 https 地址
# AI_CHAT_BASE_URL 可指向任何 OpenAI 兼容服务（官方 / 自建网关 / DeepSeek / 智谱等）
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=
# 可选项（以下为默认值，按需覆盖）
# AI_CHAT_MAX_TOOL_ROUNDS=5
# AI_CHAT_TIMEOUT=60
