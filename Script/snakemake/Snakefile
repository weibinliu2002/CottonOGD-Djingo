        uniprot_annotation=UNIPROT_DIR + "/uniprot_unique.m8",
        eggnog_import_done=FUNCTIONAL_ANNOTATION_DIR + "/EGGNOG/{genome}/import_done.txt",
        #eggno_done=snakemake_result + "/{genome}_eggno_done.txt"
    output:
        done=snakemake_result + "/{genome}_functional_annotation_done.txt"
    shell:
        """
        touch {output.done}
        """

rule parrel:
    input:
        expand(snakemake_result + "/{genome}_functional_annotation_done.txt", genome=SAMPLES),
        expand(snakemake_result + "/{genome}_sequences_done.txt", genome=SAMPLES)

rule prepare_annotation:
    """合并所有物种的蛋白序列并去重"""
    input:
        rename_pro=expand('/data/wbliu/data/CottonOGD/pandagma/work3/00_data/{species}/{species}.fa', species=annotation["new_genome"].tolist())
        
    output:
        all_proteins=FUNCTIONAL_ANNOTATION_DIR + "/data/all_proteins.fasta",
        unique_proteins=FUNCTIONAL_ANNOTATION_DIR + "/data/unique_proteins.fasta",
        unique_proteins_map=FUNCTIONAL_ANNOTATION_DIR + "/data/unique_proteins_map.txt"
    params:
        tmp_dir=FUNCTIONAL_ANNOTATION_DIR + "/data/tmp"
    shell:
        """
        mkdir -p {params.tmp_dir}
        cat {input.rename_pro} | sed '/^>/!s/[\\*\\.]//g' > {output.all_proteins} && \
        mmseqs createdb {output.all_proteins} {params.tmp_dir}/all_proteins_db && \
        mmseqs linclust {params.tmp_dir}/all_proteins_db {params.tmp_dir}/clusterDB {params.tmp_dir} --min-seq-id 1.0 -c 1.0 --cov-mode 1 --threads 20 && \
        mmseqs result2repseq {params.tmp_dir}/all_proteins_db {params.tmp_dir}/clusterDB {params.tmp_dir}/repSeqDB && \
        mmseqs convert2fasta {params.tmp_dir}/repSeqDB {output.unique_proteins} && \
        mmseqs createtsv {params.tmp_dir}/all_proteins_db {params.tmp_dir}/all_proteins_db {params.tmp_dir}/clusterDB {output.unique_proteins_map}
        """
rule uniprot:
    """使用mmseqs鉴定功能域"""
    input:
        unique_proteins=FUNCTIONAL_ANNOTATION_DIR + "/data/unique_proteins.fasta",
    output:
        uniprot_annotation=UNIPROT_DIR + "/uniprot_unique.m8",
        best_hits=UNIPROT_DIR + "/best_hits.m8",
    shell:
        """
        mmseqs easy-search {input.unique_proteins} /public2/wbliu/data/pfam_data/uniprot/uniprot_sprot.fasta  {output.uniprot_annotation} tmp --min-seq-id 0.3 -s 5.0 -e 1e-5 -c 0.5 --threads 50 && \
        sort -k1,1 -k11,11g {output.uniprot_annotation} | awk '!seen[$1]++' > {output.best_hits} && \
        python {UNIPROT_DIR}/unipro_annotation.py 
        """

rule interproscan:
    """使用InterProScan鉴定功能域（合并所有样本的最长蛋白，去重后注释）"""
    input:
        unique_proteins=FUNCTIONAL_ANNOTATION_DIR + "/data/unique_proteins.fasta",
    output:
        interproscan_annotation=INTERPROSCAN_DIR + "/all_genomes_interproscan_annotation.txt",
    params:
        tmp_dir=INTERPROSCAN_DIR + "/tmp/interproscan"
    shell:
        """
        interproscan.sh -i {input.unique_proteins} -o {output.interproscan_annotation} -cpu 16 -f tsv -T {params.tmp_dir} -dp 
        """
rule eggno:
    """使用eggNO鉴定功能域"""
    input:
        pro_file=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro_longest.fasta"),
    output:
        mmseq_annotation=directory(EGGNOG_DIR + "/{genome}.pro_longest_mmseqs_proteins_realign"),
        annotation=EGGNOG_DIR + "/{genome}.pro_longest_mmseqs_proteins_realign/{genome}.pro_longest_mmseqs_proteins_realign.emapper.annotations"
        #diamond_annotation=directory(EGGNOG_DIR + "/{genome}.pro_longest_diamond_proteins_realign"),
        #done=snakemake_result + "/{genome}_eggno_done.txt"
    params:
        COMMON_ARGS="--cpu 20 --mp_start_method forkserver --data_dir " + config["egg_db"] + " \
             --temp_dir /tmp --override --evalue 0.001 --score 60 \
             --pident 40 --query_cover 20 --subject_cover 20 --tax_scope auto \
             --target_orthologs all --go_evidence non-electronic \
             --pfam_realign realign --report_orthologs --decorate_gff yes --excel"

    shell:
        """
       
        emapper.py {params.COMMON_ARGS} --output_dir {output.mmseq_annotation} -m mmseqs -i {input.pro_file} -o {wildcards.genome}.pro_longest_mmseqs_protein_realign --itype proteins
        """

rule result_egg:
    """使用eggNO鉴定功能域"""
    input:
       annotation=EGGNOG_DIR + "/{genome}.pro_longest_mmseqs_proteins_realign/{genome}.pro_longest_mmseqs_proteins_realign.emapper.annotations"
    output:
        annotation=directory(FUNCTIONAL_ANNOTATION_DIR + "/EGGNOG/{genome}"),
        GOannotation=FUNCTIONAL_ANNOTATION_DIR + "/EGGNOG/{genome}/GOannotation.tsv",
        KOannotation=FUNCTIONAL_ANNOTATION_DIR + "/EGGNOG/{genome}/KOannotation.tsv",
    shell:
        """
        python {EGGNOG_DIR}/parse_eggNOG.py -i {input.annotation} -g {EGGNOG_DIR}/go.tb -O ath,tcc,gra,ghi,gab,hsyr,dzi,egr,rarg  -o {output.annotation}
        """

rule import_egg:
    """导入eggNO注释"""
    input:
        GOannotation=FUNCTIONAL_ANNOTATION_DIR + "/EGGNOG/{genome}/GOannotation.tsv",
        KOannotation=FUNCTIONAL_ANNOTATION_DIR + "/EGGNOG/{genome}/KOannotation.tsv",
    output:
        done=touch(FUNCTIONAL_ANNOTATION_DIR + "/EGGNOG/{genome}/import_done.txt"),
    params:
        script_dir=SCRIPT_DIR+'../snakemake/',
    shell:
        """
        cd {params.script_dir} && source venv/bin/activate && python import_eggnog_annotation.py {wildcards.genome} {FUNCTIONAL_ANNOTATION_DIR}/EGGNOG/{wildcards.genome}
        """ 