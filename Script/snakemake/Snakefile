#!/usr/bin/env snakemake
# -*- snakemake -*-

"""
CottonOGD基因组分析流程
输入: 基因组名称、FASTA文件、GFF文件
输出: 完整的基因组注释和分析结果
"""

import os
import pandas as pd

# 配置参数
configfile: "config.yaml"

# 输入文件
#SAMPLES = config["samples"]
SAMPLES_TABLE = pd.read_table("merge.txt", sep="\t", dtype=str, header=None, names=["genome", "fa", "gff"]).fillna("")
SAMPLES = SAMPLES_TABLE["genome"].tolist()
annotation=pd.read_table("/data/wbliu/data/CottonOGD/pandagma/work3/00_data/SpeciesIDs.txt", sep=" ", dtype=str, header=None, names=["new_genome", "species"]).fillna("")
annotation["new_genome"]=r'Species'+ annotation["new_genome"].str.replace(":","")
# 创建从 genome 名称到各行数据的快速查找字典（移除重复的genome名称）
SAMPLE_LOOKUP = SAMPLES_TABLE.drop_duplicates(subset="genome").set_index("genome").to_dict("index")

# 目录结构
BASE_DIR = config.get("base_dir", "/data/web/CottonOGD/OGD")
GENOME_DIR = os.path.join(BASE_DIR, "backend/data/genome")
SCRIPT_DIR = os.path.join(BASE_DIR, "Script/script")
BLAST_DIR = os.path.join(BASE_DIR, "backend/data/blastdb/CottonOGD")
ITAK_DIR = config.get("itak_dir", "/data/wbliu/data/CottonOGD/iTAK")
BUSCO_DB = config.get("busco_db", "/data/wbliu/data/CottonOGD/busco/busco_downloads/lineages/eudicots_odb10")
LAI_DIR = config.get("lai_dir", "/data/wbliu/data/CottonOGD/LAI")
BUSCO_DIR = config.get("busco_dir", "/data/wbliu/data/CottonOGD/busco")
EGGNOG_DIR = config.get("eggnog", "/data/wbliu/data/CottonOGD/eggnog_annoation")
FUNCTIONAL_ANNOTATION_DIR = config.get("functional_annotation", "/data/wbliu/data/CottonOGD/Function")
INTERPROSCAN_DIR =os.path.join(FUNCTIONAL_ANNOTATION_DIR, "interproscan")
UNIPROT_DIR =os.path.join(FUNCTIONAL_ANNOTATION_DIR, "uniprot")
eggnog_db = config.get("egg_db", "/public2/wbliu/data/pfam_data/eggnog")
EGGNOG_DIR =config.get("eggnog_db",'/data/wbliu/data/CottonOGD/eggnog_annoation/eggnog')
uniprorot_db = config.get("uniprot_db", "/public2/wbliu/data/pfam_data/uniprot/uniprot")
snakemake_result=os.path.join(BASE_DIR, "snakemake_result")



# ============================================================
# 规则定义
# ============================================================

rule all:
    """完成所有分析步骤"""
    input:
        expand(snakemake_result + "/{genome}_jbrowse.txt", genome=SAMPLES),
        expand(snakemake_result + "/{genome}_tf_done.txt", genome=SAMPLES),
        expand(snakemake_result + "/{genome}_busco.txt", genome=SAMPLES),
        expand(snakemake_result + "/{genome}_lai.txt", genome=SAMPLES),
        expand(snakemake_result + "/{genome}_geneseq_done.txt", genome=SAMPLES),
        expand(snakemake_result + "/{genome}_functional_annotation_done.txt", genome=SAMPLES)





# ------------------------------------------------------------------
# add_jbrowse — jbrowse_path 改为 params
# ------------------------------------------------------------------
rule add_jbrowse:
    """添加JBrowse轨道"""
    input:
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
        gff_file = lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["gff"]),
    output:
        done=snakemake_result + "/{genome}_jbrowse.txt",
        #fa_file=os.path.join(GENOME_DIR, "{genome}", "{genome}.genome.fa.gz"),
        gff_file = os.path.join(GENOME_DIR, "{genome}", "{genome}.gff.gz"),
    params:
        jbrowse_path=os.path.join(BASE_DIR, "backend/static/jbrowse/data/{genome}"),
        genome_path=os.path.join(GENOME_DIR, "{genome}")
    shell:
        """
        bash {SCRIPT_DIR}/../snakemake/fix_gff.sh {input.gff_file} {output.gff_file}
        #bash {SCRIPT_DIR}/add_jbrowes.sh {wildcards.genome} {input.fa_file} {output.gff_file} {params.genome_path} {params.jbrowse_path} {SCRIPT_DIR}
        touch {output.done}
        """


rule add_Species_info:
    """将物种信息导入到Species_info表"""
    input:
        species_csv="species_info.csv"
    output:
        done=snakemake_result + "/{genome}_species_info_added.txt"
    params:
        genome="{wildcards.genome}"
    shell:
        """
        cd {BASE_DIR}/backend && source venv/bin/activate &&
        python {SCRIPT_DIR}/snakemake/import_species_info.py
            --csv {input.species_csv} &&
        touch {output.done}
        """

