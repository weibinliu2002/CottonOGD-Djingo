rule run_busco:
    """运行BUSCO评估基因组完整性"""
    input:
        fa_file=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro_longest.fasta"),
    output:
        done=snakemake_result + "/{genome}_busco.txt"
    params:
        env="busco",
        busco_db=config["busco_db"],
        outdir=os.path.join(GENOME_DIR, "{genome}/busco")
    shell:
        """
        mkdir -p {params.outdir} &&
        busco -i {input.fa_file}
              --out_path {params.outdir}
              -o {wildcards.genome}
              --lineage_dataset {params.busco_db}
              -f
              -m proteins
              --augustus
              -c 10
              --augustus_species Arabidopsis
              --long
              --offline &&
        touch {output.done}
        """


rule run_lai:
    """计算LAI（LTR Assembly Index）"""
    input:
        #species_added="{genome}_species_added.txt"
    output:
        done=snakemake_result + "/{genome}_lai.txt"
    shell:
        """
        bash {SCRIPT_DIR}/../snakemake/LAI_for_snakemake.sh {wildcards.genome} &&
        touch {output.done}
        """


rule extract_longest_fa:
    """提取最长转录本序列"""
    input:
        pro=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro.fa"),
        #cds=os.path.join(GENOME_DIR, "{genome}", "{genome}.cds.fa"),
        #mrna=os.path.join(GENOME_DIR, "{genome}", "{genome}.mrna.fa")
    output:
        pro_longest=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro_longest.fasta"),
        #cds_longest=os.path.join(GENOME_DIR, "{genome}", "{genome}.cds_longest.fasta"),
        #mrna_longest=os.path.join(GENOME_DIR, "{genome}", "{genome}.mrna_longest.fasta")
    shell:
        """
        Rscript {SCRIPT_DIR}/longest.R {input.pro} {output.pro_longest} 
        wait
        """


# ======================================================================
# ★ makeblast 规则 — 修正了 3 个语法错误 ★
# ======================================================================
rule makeblast:
    """构建BLAST数据库"""
    input:
        blast_path=os.path.join(BASE_DIR, 'backend', 'soft', 'UNIX', 'blast+', 'bin'),  # 修复1: 加逗号
        pro_longest=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro_longest.fasta"),
        cds_longest=os.path.join(GENOME_DIR, "{genome}", "{genome}.cds_longest.fasta"),
        mrna_longest=os.path.join(GENOME_DIR, "{genome}", "{genome}.mrna_longest.fasta"),
        fa_file=os.path.join(GENOME_DIR, "{genome}", "{genome}.fa")
    params:
        blast_db=os.path.join(BLAST_DIR, "{genome}")  # 修复2: {genome} 加引号
    output:
        done=snakemake_result + "/{genome}_blast_done.txt"
    shell:
        """
        bash {SCRIPT_DIR}/add_blast_db.sh {wildcards.genome} {input.fa_file} {input.mrna_longest} {input.cds_longest} {input.pro_longest} {input.blast_path} {params.blast_db} &&
        touch {output.done}
        """


# ------------------------------------------------------------------
# 解压缩 GFF 文件
# ------------------------------------------------------------------
rule decompress_gff:
    """解压缩 GFF 文件并过滤，只保留 FASTA 中存在的序列"""
    input:
        jbrowse_done=snakemake_result + "/{genome}_jbrowse.txt",
        gff_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, "{genome}.gff.gz"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
    shell:
        """
        # 解压缩 GFF，过滤序列，检查坐标范围，将 strand=? 替换为 strand=.
        bgzip -d -c {input.gff_file} | awk 'NR==FNR {{seqs[$1]=1; len[$1]=$2; next}} /^#/ {{print; next}} ($1 in seqs) {{if($7==\"?\")$7=\".\"; if($4<=$5 && $4>=1 && $5<=len[$1]) print}}' {input.fa_file}.fai - > {output.gff_uncompressed}
        """

# ------------------------------------------------------------------
# 序列提取规则（七个小规则）
# ------------------------------------------------------------------
rule extract_mrna:
    """提取 mRNA 序列"""
    input:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        mrna=os.path.join(GENOME_DIR, "{genome}", "{genome}.mrna.fa"),
    shell:
        """
        gffread -E {input.gff_uncompressed} -g {input.fa_file} -u {output.mrna} --w-nocds
        """

rule extract_cdna:
    """提取 cDNA 序列"""
    input:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        cdna=os.path.join(GENOME_DIR, "{genome}", "{genome}.cdna.fa"),
    shell:
        """
        gffread -E {input.gff_uncompressed} -g {input.fa_file} -w {output.cdna} --w-nocds
        """

rule extract_cds:
    """提取 CDS 序列"""
    input:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        cds=os.path.join(GENOME_DIR, "{genome}", "{genome}.cds.fa"),
    shell:
        """
        gffread -E {input.gff_uncompressed} -g {input.fa_file} -x {output.cds} --w-nocds
        """

rule extract_pro:
    """提取蛋白质序列"""
    input:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        pro=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro.fa"),
    shell:
        """
        gffread -E {input.gff_uncompressed} -g {input.fa_file} -y {output.pro} --w-nocds
        """

rule extract_gene_genome:
    """提取基因全长序列"""
    input:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        gene_genome=os.path.join(GENOME_DIR, "{genome}", "{genome}.gene_genome.fa"),
    shell:
        """
        Rscript {SCRIPT_DIR}/../snakemake/extract_seq.R {input.fa_file} {input.gff_uncompressed} {output.gene_genome}
        """

rule extract_upstream:
    """提取上游 2000bp 序列"""
    input:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        upstream=os.path.join(GENOME_DIR, "{genome}", "{genome}.upstream20000.fa"),
    shell:
        """
        java -cp /data/wbliu/soft/TBtools-II-2.311/TBtools_JRE1.6.jar biocjava.bioIO.GFF.ExtractFeaturefromGFF3andGenome \\
            --inGtf {input.gff_uncompressed} \\
            --inGenome {input.fa_file} \\
            --outFile {output.upstream} \\
            --targetFeature CDS \\
            --targetIdTag Parent \\
            --upStreamBases 2000 \\
            --onlyCheck false \\
            --onlyRetainFlank true
        """

rule extract_downstream:
    """提取下游 2000bp 序列"""
    input:
        gff_uncompressed=os.path.join(GENOME_DIR, "{genome}", "{genome}.gff"),
        fa_file=lambda wildcards: os.path.join(GENOME_DIR, wildcards.genome, SAMPLE_LOOKUP[wildcards.genome]["fa"]),
    output:
        downstream=os.path.join(GENOME_DIR, "{genome}", "{genome}.downstream20000.fa"),
    shell:
        """
        java -cp /data/wbliu/soft/TBtools-II-2.311/TBtools_JRE1.6.jar biocjava.bioIO.GFF.ExtractFeaturefromGFF3andGenome \\
            --inGtf {input.gff_uncompressed} \\
            --inGenome {input.fa_file} \\
            --outFile {output.downstream} \\
            --targetFeature CDS \\
            --targetIdTag Parent \\
            --downStreamBases 2000 \\
            --onlyCheck false \\
            --onlyRetainFlank true
        """

# ------------------------------------------------------------------
# 汇总规则：等待所有序列提取完成
# ------------------------------------------------------------------
rule extract_sequences:
    """汇总规则：等待所有序列提取完成"""
    input:
        rules.extract_mrna.output,
        rules.extract_cdna.output,
        rules.extract_cds.output,
        rules.extract_pro.output,
        rules.extract_gene_genome.output,
        rules.extract_upstream.output,
        rules.extract_downstream.output
    output:
        done=snakemake_result + "/{genome}_sequences_done.txt"
    shell:
        """
        touch {output.done}
        """
rule import_geneseq:
    """将序列导入geneseq表"""
    input:
        sequences_done=snakemake_result + "/{genome}_sequences_done.txt",
        pro=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro.fa"),
        cds=os.path.join(GENOME_DIR, "{genome}", "{genome}.cds.fa"),
        mrna=os.path.join(GENOME_DIR, "{genome}", "{genome}.mrna.fa"),
        cdna=os.path.join(GENOME_DIR, "{genome}", "{genome}.cdna.fa"),
        gene_genome=os.path.join(GENOME_DIR, "{genome}", "{genome}.gene_genome.fa"),
        upstream=os.path.join(GENOME_DIR, "{genome}", "{genome}.upstream20000.fa"),
        downstream=os.path.join(GENOME_DIR, "{genome}", "{genome}.downstream20000.fa"),
    output:
        done=snakemake_result + "/{genome}_geneseq_done.txt"
    threads: 1
    shell:
        """
        cd {BASE_DIR}/backend && source venv/bin/activate &&
        python {SCRIPT_DIR}/../snakemake/import_sequences_to_geneseq.py
            --species {wildcards.genome} &&
        touch {output.done}
        """


rule run_itak:
    """使用iTAK鉴定转录因子"""
    input:
        sequences_done=snakemake_result + "/{genome}_sequences_done.txt",
        pro_file=os.path.join(GENOME_DIR, "{genome}", "{genome}.pro_longest.fasta"),
    output:
        done=snakemake_result + "/{genome}_tf_done.txt"
       
    params:
        outdir=os.path.join(ITAK_DIR, "iTAK_result", "{genome}.pro")
    shell:
        """
        mkdir -p {params.outdir} &&
        cd {ITAK_DIR} &&
        python iTAK.py -i {input.pro_file} -o {params.outdir} &&
        touch {output.done}
        """


rule import_tf_to_genefamily:
    """将iTAK结果导入genefamily表"""
    input:
        tf_done="{genome}_tf_done.txt",
        transcriptmaster_done="{genome}_transcriptmaster_done.txt"
    output:
        done=snakemake_result + "/{genome}_genefamily_done.txt"
    shell:
        """
        cd {BASE_DIR}/backend && source venv/bin/activate &&
        python {SCRIPT_DIR}/import_itak_to_genefamily.py
            --species {wildcards.genome} &&
        touch {output.done}
        """


rule functional_annotation:
    input:
